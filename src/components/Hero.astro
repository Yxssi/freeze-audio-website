---
import { Image } from 'astro:assets';
import pluginUi from '../assets/freeze-ui.png';
import DownloadIcon from './DownloadIcon.astro';
import { release } from '../site';
import {
  defaultLang,
  homePath,
  isLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);
const home = homePath(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="copy">
      <p class="eyebrow">{t('hero.eyebrow', { version: release.version })}</p>
      <h1 id="hero-title">
        {t('hero.title.before')}<span class="accent">{t('hero.title.accent')}</span>{t('hero.title.after')}
      </h1>
      <p class="lead">{t('hero.lead')}</p>
      <div class="cta-row">
        {
          release.platforms.map((platform) => (
            <a class="btn btn-primary btn-lg" href={platform.installer.href} download data-cuelume-tap>
              <DownloadIcon />
              {t('hero.cta', { platform: platform.label })}
            </a>
          ))
        }
      </div>
      <p class="reassure">
        {t('hero.reassure')} <a href={`${home}#download`} data-cuelume-navigate data-cuelume-emphasis="subtle">{t('hero.otherFiles')}</a>
      </p>
    </div>

    <div class="visual">
      <Image
        class="shot"
        src={pluginUi}
        widths={[600, 900, 1400]}
        sizes="(min-width: 64rem) 52vw, calc(100vw - 2.5rem)"
        alt={t('hero.shot.alt')}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(var(--space-12), 6vw, var(--space-24)) var(--section-y);
  }

  .hero-inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .copy {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.2rem + 3.4vw, 4.25rem);
  }

  .lead {
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: var(--fs-lead);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .reassure {
    color: var(--ink-3);
    font-size: var(--fs-small);
  }

  .shot {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    box-shadow:
      0 0 0 1px var(--line-dark),
      0 40px 80px -30px rgb(26 22 32 / 0.55);
  }

  @media (max-width: 30rem) {
    .cta-row {
      width: 100%;
    }
    .cta-row .btn {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 64rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 11fr) minmax(0, 13fr);
      gap: var(--space-16);
    }

    .visual {
      margin-inline-end: calc(-1 * var(--gutter));
    }

    .shot {
      border-end-end-radius: 0;
      border-start-end-radius: 0;
    }
  }
</style>
