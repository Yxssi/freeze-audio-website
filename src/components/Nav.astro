---
import Wordmark from './Wordmark.astro';
import {
  defaultLang,
  homePath,
  isLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);
const home = homePath(lang);
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={home} aria-label={t('nav.home')}>
      <Wordmark />
    </a>
    <div class="nav-end">
      <nav class="nav-links" aria-label={t('nav.sections')} data-cuelume-emphasis="subtle">
        <ul>
          <li><a href={`${home}#features`} data-cuelume-navigate>{t('nav.features')}</a></li>
          <li><a href={`${home}#install`} data-cuelume-navigate>{t('nav.install')}</a></li>
        </ul>
      </nav>
      <nav class="lang" aria-label={t('nav.lang')}>
        <a
          href={homePath('en')}
          lang="en"
          hreflang="en"
          aria-current={lang === 'en' ? 'page' : undefined}
        >
          EN
        </a>
        <span aria-hidden="true">/</span>
        <a
          href={homePath('fr')}
          lang="fr"
          hreflang="fr"
          aria-current={lang === 'fr' ? 'page' : undefined}
        >
          FR
        </a>
      </nav>
      <button
        class="sound"
        type="button"
        data-sound-toggle
        aria-pressed="false"
        aria-label={t('nav.sound')}
        title={t('nav.sound')}
      >
        <svg class="sound-on" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
        </svg>
        <svg class="sound-off" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
          <path class="wave" d="M16 9.5l5 5M21 9.5l-5 5" />
        </svg>
      </button>
    </div>
    <a class="btn btn-primary nav-cta" href={`${home}#download`} data-cuelume-navigate>
      {t('nav.download')}
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 4.25rem;
  }

  .brand {
    justify-self: start;
    display: inline-flex;
    color: var(--ink);
    font-size: 2rem;
    padding-block: var(--space-2);
  }

  .nav-cta {
    min-height: 2.5rem;
    padding-block: 0.5rem;
  }

  .nav-end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-links ul {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .lang a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    color: var(--ink-3);
    text-decoration: none;
  }

  .lang a:hover {
    color: var(--ink);
  }

  .lang a[aria-current='page'] {
    color: var(--ink);
  }

  .sound {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }

  .sound:hover {
    color: var(--ink);
    background: var(--border-subtle);
  }

  .sound svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sound path:first-child {
    fill: currentColor;
  }

  .sound[aria-pressed='true'] .sound-off,
  .sound[aria-pressed='false'] .sound-on {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .nav-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand cta'
        'end end';
      gap: var(--space-2) var(--space-4);
    }
    .brand {
      grid-area: brand;
      font-size: 1.625rem;
    }
    .nav-cta {
      grid-area: cta;
    }
    .nav-end {
      grid-area: end;
      justify-self: end;
      gap: var(--space-4);
    }
    .nav-links ul {
      gap: var(--space-4);
    }
    .nav-links a {
      font-size: var(--fs-small);
    }
  }
</style>
