---
import Wordmark from './Wordmark.astro';
import { release } from '../site';
import {
  defaultLang,
  homePath,
  isLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);
const home = homePath(lang);
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={home} aria-label={t('nav.home')}>
      <Wordmark />
    </a>
    <a class="btn btn-primary nav-cta" href={release.downloadPath} download>
      {t('nav.download')}
    </a>
    <div class="nav-end">
      <nav class="nav-links" aria-label={t('nav.sections')}>
        <ul>
          <li><a href={`${home}#engines`}>{t('nav.engines')}</a></li>
          <li><a href={`${home}#install`}>{t('nav.install')}</a></li>
          <!-- <li><a href={`${home}#faq`}>{t('nav.faq')}</a></li> -->
        </ul>
      </nav>
      <nav class="lang" aria-label={t('nav.lang')}>
        <a
          href={homePath('en')}
          lang="en"
          hreflang="en"
          aria-current={lang === 'en' ? 'page' : undefined}
        >
          EN
        </a>
        <span aria-hidden="true">/</span>
        <a
          href={homePath('fr')}
          lang="fr"
          hreflang="fr"
          aria-current={lang === 'fr' ? 'page' : undefined}
        >
          FR
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    min-height: 4.25rem;
  }

  .brand {
    justify-self: start;
    display: inline-flex;
    color: var(--ink);
    font-size: 2rem;
    padding-block: var(--space-2);
  }

  .nav-cta {
    min-height: 2.5rem;
    padding-block: 0.5rem;
  }

  .nav-end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-links ul {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--ink-2);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .lang a {
    color: var(--ink-3);
    text-decoration: none;
    padding: 0.25rem 0.15rem;
  }

  .lang a:hover {
    color: var(--ink);
  }

  .lang a[aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 47.99rem) {
    .nav-inner {
      grid-template-columns: 1fr auto auto;
    }
    .nav-links {
      display: none;
    }
    .brand {
      font-size: 1.625rem;
    }
  }
</style>
