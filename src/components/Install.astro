---
import { release, type PlatformId } from '../site';
import {
  defaultLang,
  isLang,
  templateParts,
  useTranslations,
  type Lang,
  type UiKey,
} from '../i18n/ui';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);

const paths = {
  component: 'Freeze.component',
  vst3: 'Freeze Audio.vst3',
  macComponents: '~/Library/Audio/Plug-Ins/Components',
  macVst3: '~/Library/Audio/Plug-Ins/VST3',
  windowsVst3: 'C:\\Program Files\\Common Files\\VST3',
};

const installerName = (id: PlatformId) =>
  release.platforms.find((platform) => platform.id === id)?.installer.name ?? '';

interface Guide {
  id: PlatformId;
  label: string;
  steps: Array<{ key: UiKey; slots: Record<string, string> }>;
  noteTitle: UiKey;
  noteBody: UiKey;
}

const guides: Guide[] = [
  {
    id: 'macos',
    label: 'macOS',
    steps: [
      { key: 'install.macos.step1', slots: { file: installerName('macos') } },
      {
        key: 'install.macos.step2',
        slots: {
          component: paths.component,
          componentFolder: paths.macComponents,
          vst3: paths.vst3,
          vst3Folder: paths.macVst3,
        },
      },
      { key: 'install.macos.step3', slots: {} },
    ],
    noteTitle: 'install.macos.note.title',
    noteBody: 'install.macos.note.body',
  },
  {
    id: 'windows',
    label: 'Windows',
    steps: [
      { key: 'install.windows.step1', slots: { file: installerName('windows'), folder: paths.windowsVst3 } },
      { key: 'install.windows.step2', slots: { vst3: paths.vst3 } },
      { key: 'install.windows.step3', slots: {} },
    ],
    noteTitle: 'install.windows.note.title',
    noteBody: 'install.windows.note.body',
  },
];
---

<section class="section install" id="install" aria-labelledby="install-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t('install.eyebrow')}</p>
      <h2 id="install-title">
        {t('install.title.before')}<span class="accent">{t('install.title.accent')}</span>
      </h2>
    </div>

    <div class="guides">
      {
        guides.map((guide) => (
          <article class="guide" aria-labelledby={`install-${guide.id}`}>
            <h3 id={`install-${guide.id}`}>{guide.label}</h3>
            <ol class="steps">
              {guide.steps.map((step) => (
                <li>
                  {templateParts(t(step.key)).map((part) =>
                    part.slot ? <code>{step.slots[part.name]}</code> : part.text,
                  )}
                </li>
              ))}
            </ol>
            <aside class="note" aria-label={t(guide.noteTitle)}>
              <p class="note-title">{t(guide.noteTitle)}</p>
              <p>{t(guide.noteBody)}</p>
            </aside>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .install {
    background: var(--bg-tint);
  }

  .guides {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-4);
  }

  .guide {
    display: grid;
    align-content: start;
    gap: var(--space-6);
    padding: clamp(var(--space-6), 4vw, var(--space-10));
    background: var(--bg-raised);
    border-radius: var(--radius-xl);
  }

  h3 {
    font-size: var(--fs-h3);
    line-height: 1.1;
  }

  .steps {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    position: relative;
    min-height: 2rem;
    padding: 0.25rem 0 0 calc(2rem + var(--space-3));
    color: var(--ink-2);
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background: var(--color-amethyst);
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  code {
    padding: 0.1em 0.35em;
    background: var(--bg-lavender);
    border-radius: var(--radius-sm);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .note {
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-lavender-grey);
    border-radius: var(--radius-lg);
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .note-title {
    margin-bottom: var(--space-2);
    color: var(--ink);
    font-weight: 600;
  }
</style>
