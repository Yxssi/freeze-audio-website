---
import { release } from '../site';
import {
  defaultLang,
  isLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);
const target = '~/Library/Audio/Plug-Ins/Components';
const zipName = release.downloadPath.split('/').pop() ?? '';
---

<section class="section install" id="install" aria-labelledby="install-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t('install.eyebrow')}</p>
      <h2 id="install-title">
        {t('install.title.before')}<span class="accent">{t('install.title.accent')}</span>
      </h2>
    </div>

    <ol class="steps">
      <li>
        <h3>{t('install.step1.title')}</h3>
        <p>{t('install.step1.body', { file: zipName })}</p>
      </li>
      <li>
        <h3>{t('install.step2.title')}</h3>
        <p>
          {t('install.step2.body.before')}<code>{target}</code>{t('install.step2.body.after')}
        </p>
      </li>
      <li>
        <h3>{t('install.step3.title')}</h3>
        <p>{t('install.step3.body')}</p>
      </li>
    </ol>

    <aside class="gatekeeper" role="note" aria-labelledby="gate-title">
      <h3 id="gate-title">{t('install.gate.title')}</h3>
      <p>{t('install.gate.body')}</p>
      <p>{t('install.gate.gui')}</p>
      <p>{t('install.gate.term')}</p>
      <code>xattr -dr com.apple.quarantine {target}/Freeze.component</code>
    </aside>
  </div>
</section>

<style>
  .install {
    background: var(--bg-tint);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    padding: var(--space-8) var(--space-6);
    background: var(--bg-raised);
    border-radius: var(--radius-xl);
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--color-amethyst);
    color: var(--ink);
    font-weight: 700;
  }

  h3 {
    font-size: var(--fs-h3-card);
    line-height: 1.3;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
  }

  .steps p {
    color: var(--ink-2);
  }

  code {
    padding: 0.1em 0.35em;
    background: var(--bg-lavender);
    border-radius: var(--radius-sm);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .gatekeeper {
    /* Structural width, not a measure: keeps the xattr command on one line.
       The prose inside is capped at --measure. */
    max-width: 52rem;
    margin-top: var(--space-10);
    padding: var(--space-8) var(--space-6);
    border: 1px solid var(--color-lavender-grey);
    border-radius: var(--radius-xl);
    background: var(--bg-raised);
  }

  .gatekeeper h3 {
    margin-bottom: var(--space-3);
  }

  .gatekeeper p {
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .gatekeeper p + p {
    margin-top: var(--space-2);
  }

  .gatekeeper code {
    display: block;
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    font-size: 0.9rem;
    /* A shell command must never wrap: a line break would be copied as part
       of the command. Overrides the shared `code` overflow-wrap. */
    white-space: pre;
    overflow-wrap: normal;
    overflow-x: auto;
  }
</style>
