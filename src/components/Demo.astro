---
import { demos } from '../site';
import {
  defaultLang,
  isLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);
---

{
  demos.length > 0 && (
    <section class="demo on-dark" id="listen" aria-labelledby="demo-title">
      <div class="container">
        <div class="head">
          <p class="eyebrow">{t('demo.eyebrow')}</p>
          <h2 id="demo-title">
            {t('demo.title.before')}<span class="accent">{t('demo.title.accent')}</span>
          </h2>
          <p class="lead">{t('demo.lead')}</p>
        </div>

        <ul class="cards">
          {demos.map((d) => (
            <li class="card">
              <h3>{d.engine}</h3>
              <div class="track">
                <span id={`${d.engine}-dry`}>{t('demo.dry')}</span>
                <audio controls preload="none" src={d.dry} aria-labelledby={`${d.engine}-dry`} />
              </div>
              <div class="track">
                <span id={`${d.engine}-wet`}>{t('demo.wet')}</span>
                <audio controls preload="none" src={d.wet} aria-labelledby={`${d.engine}-wet`} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .demo {
    padding-block: var(--section-y);
    background: var(--bg-dark);
    color: var(--ink-inverse);
  }

  .head {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
    margin-bottom: var(--space-12);
  }

  .eyebrow {
    color: var(--color-light-blue);
  }

  .eyebrow::before {
    background: var(--color-light-blue);
  }

  .lead {
    max-width: var(--measure);
    color: var(--ink-inverse-2);
    font-size: var(--fs-lead);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--bg-dark-2);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-xl);
  }

  h3 {
    font-size: var(--fs-h3-card-lg);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .track {
    display: grid;
    gap: var(--space-2);
    color: var(--ink-inverse-2);
    font-size: var(--fs-small);
  }

  audio {
    width: 100%;
  }
</style>
