---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Features from './Features.astro';
import Demo from './Demo.astro';
import Download from './Download.astro';
import Install from './Install.astro';
import Footer from './Footer.astro';
import { release, site } from '../site';
import {
  defaultLang,
  isLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  alternateName: 'Freeze',
  description: t('meta.description'),
  url: site.url,
  applicationCategory: 'MultimediaApplication',
  applicationSubCategory: t('meta.jsonLdSubCategory'),
  operatingSystem: release.operatingSystems,
  softwareVersion: release.version,
  downloadUrl: release.platforms.map((platform) => new URL(platform.installer.href, site.url).href),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  image: new URL('/og.png', site.url).href,
  inLanguage: lang,
  author: { '@type': 'Person', name: site.author },
};
---

<Base jsonLd={jsonLd}>
  <Nav />
  <main id="content" tabindex="-1">
    <Hero />
    <Demo />
    <Features />
    <Download />
    <Install />
  </main>
  <Footer />
</Base>

<style>
  main:focus {
    outline: none;
  }
</style>
