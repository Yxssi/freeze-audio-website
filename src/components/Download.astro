---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { release } from '../site';
import {
  defaultLang,
  isLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);

const fileName = release.downloadPath.split('/').pop() ?? '';
const file = readFileSync(join(process.cwd(), 'public', release.downloadPath));
const sizeKo = Math.round(file.byteLength / 1024);
const sha256 = createHash('sha256').update(file).digest('hex');
---

<section class="section download" id="download" aria-labelledby="download-title">
  <div class="container">
    <div class="card">
      <div class="copy">
        <p class="eyebrow">{t('download.eyebrow')}</p>
        <h2 id="download-title">
          {t('download.title.before', { version: release.version })}<span class="accent">{t('download.title.accent')}</span>
        </h2>
        <p class="lead">{t('download.lead')}</p>
      </div>

      <div class="action">
        <a class="btn btn-primary btn-lg" href={release.downloadPath} download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14"></path>
          </svg>
          {t('download.cta', { size: sizeKo })}
        </a>
        <dl class="facts">
          <div><dt>{t('download.file')}</dt><dd>{fileName}</dd></div>
          <div><dt>{t('download.version')}</dt><dd>{release.version}</dd></div>
          <div><dt>{t('download.system')}</dt><dd>{t('download.systemValue', { min: release.minMacOS })}</dd></div>
          <div class="sha"><dt>{t('download.sha')}</dt><dd><code>{sha256}</code></dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .card {
    display: grid;
    gap: var(--space-10);
    padding: clamp(var(--space-8), 5vw, var(--space-16));
    background: var(--bg-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: 0 30px 60px -40px rgb(26 22 32 / 0.35);
  }

  @media (min-width: 64rem) {
    .card {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-24);
    }
  }

  .copy {
    display: grid;
    gap: var(--space-4);
  }

  .lead {
    color: var(--ink-2);
    font-size: var(--fs-lead);
  }

  .action {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-4);
    width: 100%;
    margin: 0;
  }

  .facts div {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .facts .sha {
    grid-column: 1 / -1;
  }

  dt {
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  dd {
    margin: var(--space-2) 0 0;
    overflow-wrap: anywhere;
    font-weight: 500;
  }

  .sha code {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .btn-lg {
    white-space: normal;
  }
</style>
