---
import { Image } from 'astro:assets';
import pluginUi from '../assets/freeze-ui.png';
import {
  defaultLang,
  isLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);

const features = [
  { title: t('showcase.modes.title'), body: t('showcase.modes.body') },
  { title: t('showcase.time.title'), body: t('showcase.time.body') },
  { title: t('showcase.knobs.title'), body: t('showcase.knobs.body') },
  { title: t('showcase.scope.title'), body: t('showcase.scope.body') },
];
---

<section class="showcase on-dark" aria-labelledby="interface-title">
  <div class="container">
    <div class="head">
      <p class="eyebrow">{t('showcase.eyebrow')}</p>
      <h2 id="interface-title">
        {t('showcase.title.before')}<span class="accent">{t('showcase.title.accent')}</span>
      </h2>
    </div>

    <figure class="figure">
      <Image
        class="shot"
        src={pluginUi}
        widths={[700, 1080, 1400]}
        sizes="(min-width: 1180px) 1080px, calc(100vw - 2.5rem)"
        alt={t('showcase.alt')}
        loading="lazy"
        decoding="async"
      />
      <figcaption>{t('showcase.caption')}</figcaption>
    </figure>

    <ul class="features">
      {
        features.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .showcase {
    padding-block: var(--section-y);
    background: var(--bg-dark);
    color: var(--ink-inverse);
  }

  .head {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
    margin-bottom: var(--space-16);
  }

  .eyebrow {
    color: var(--color-light-blue);
  }

  .eyebrow::before {
    background: var(--color-light-blue);
  }

  .figure {
    max-width: 1080px;
    margin: 0 auto;
  }

  .shot {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    box-shadow:
      0 0 0 1px var(--line-dark),
      0 40px 80px -30px rgb(0 0 0 / 0.6);
  }

  figcaption {
    margin-top: var(--space-4);
    color: var(--ink-inverse-2);
    font-size: var(--fs-small);
    text-align: center;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-8);
    margin: var(--space-16) 0 0;
    padding: 0;
    list-style: none;
  }

  .features li {
    padding-top: var(--space-6);
    border-top: 1px solid var(--line-dark);
  }

  h3 {
    font-size: 1.375rem;
    line-height: 1.3;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
  }

  .features p {
    color: var(--ink-inverse-2);
  }
</style>
